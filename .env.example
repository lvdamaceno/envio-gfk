# --- Sankhya (API oficial / OAuth 2.0) ---
# Produção: https://api.sankhya.com.br | Sandbox: https://api.sandbox.sankhya.com.br
SANKHYA_BASE_URL=https://api.sankhya.com.br
# Client ID/Secret: Área do Desenvolvedor (componente de integração da solução)
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
# X-Token: Sankhya Om > Configurações Gateway > Cadastrar aplicação
SANKHYA_X_TOKEN=

# --- FTP de destino ---
FTP_HOST=
FTP_PORTA=21
FTP_USUARIO=
FTP_SENHA=
FTP_DIRETORIO=/
# true para FTPS (FTP sobre TLS explícito). O FTP da GfK (gimftp.gfk.com) EXIGE true.
FTP_TLS=true

# --- Telegram (opcional; sem isso as notificações só vão para o log) ---
# Token do bot criado no @BotFather
TELEGRAM_BOT_TOKEN=
# Chat que recebe os avisos (usuário, grupo ou canal; grupos têm ID negativo)
TELEGRAM_CHAT_ID=
